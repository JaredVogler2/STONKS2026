# APEX web (Vercel) environment. Copy the NAMES into Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values. None of these may be prefixed NEXT_PUBLIC_ (that would ship them to browsers).
# Generate random secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- mode ---------------------------------------------------------------------------------------------
# DEMO | PAPER_LIVE_DATA | PERSONAL_RESEARCH | GROUP_POSITION_ALERTS (start with PAPER_LIVE_DATA on a real deployment)
APEX_MODE=DEMO
# Production URL without trailing slash (used for the Discord OAuth redirect)
APEX_PUBLIC_BASE_URL=

# --- database (Supabase Postgres; required outside DEMO) -----------------------------------------------
# Use the Supavisor TRANSACTION pooler URI (port 6543) for serverless functions.
DATABASE_URL=
# Set to 1 only if you want the app to apply migrations at boot; normally run `pnpm --filter @apex/web db:migrate`.
APEX_AUTO_MIGRATE=

# --- secrets (32 random bytes, base64) --------------------------------------------------------------------
# signs owner session cookies
APEX_SESSION_SECRET=
# encrypts integration credentials at rest (exactly 32 bytes). Rotation: move the old one to *_PREVIOUS and bump the version.
APEX_CONFIG_ENCRYPTION_KEY=
APEX_CONFIG_ENCRYPTION_KEY_VERSION=1
APEX_CONFIG_ENCRYPTION_KEY_PREVIOUS=
APEX_CONFIG_ENCRYPTION_KEY_PREVIOUS_VERSION=
# shared HMAC key for the Pi agent API (the Pi also proves its own device key at pairing)
AGENT_HMAC_SECRET=
AGENT_HMAC_SECRET_PREVIOUS=
# HMAC key for the GitHub Actions release identity (same value stored as a GitHub Environment secret)
APEX_RELEASE_HMAC_SECRET=
APEX_RELEASE_HMAC_SECRET_PREVIOUS=

# --- model registry ---------------------------------------------------------------------------------------
# JSON map of signer key version -> Ed25519 PUBLIC key (base64url, 43 chars). Public keys only; the signing key lives in GitHub.
APEX_MODEL_TRUSTED_KEYS={}

# --- owner sign-in (Discord OAuth2 with PKCE) --------------------------------------------------------------
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# comma-separated Discord user ids allowed to sign in to the dashboard
APEX_OWNER_DISCORD_IDS=

# --- local development only (ignored on Vercel) ----------------------------------------------------------
# APEX_ALLOW_LOCAL_DEV_LOGIN=1   enables the "Enter local DEMO" button for a local DEMO process with no DATABASE_URL
# APEX_PGLITE_DIR=.apex-local/pglite
