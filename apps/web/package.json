{
  "name": "@apex/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "gen": "node scripts/gen-embedded.mjs",
    "gen:check": "node scripts/gen-embedded.mjs --check",
    "prebuild": "node scripts/gen-embedded.mjs",
    "predev": "node scripts/gen-embedded.mjs",
    "demo": "node scripts/gen-embedded.mjs && node scripts/demo.mjs",
    "demo:prod": "node scripts/demo.mjs --prod"
  },
  "dependencies": {
    "@apex/contracts": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "16.3.8",
    "postgres": "3.4.7",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.2.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.37.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
