# APEX Raspberry Pi worker + Discord bot configuration. PLACEHOLDERS ONLY.
# Copy to ~/.config/apex/apex.env (the systemd units read APEX_ENV_FILE), then: chmod 600 ~/.config/apex/apex.env
# Never commit the real file, paste it into chat or Discord, or put it in a screenshot.

# ---- mode and state --------------------------------------------------------------------------------------------
# DEMO | PAPER_LIVE_DATA | PERSONAL_RESEARCH | GROUP_POSITION_ALERTS (GROUP_* stays off until compliance review)
APEX_MODE=DEMO
# State dir shared by `apex worker` and `apex bot` (keys, local SQLite, spool, models). Owner-only (0700).
APEX_STATE_DIR=/home/pi/.apex
# Optional: the bot's local SQLite. Default $APEX_STATE_DIR/apex_local.sqlite3. Worker and bot MUST use the same file.
# APEX_LOCAL_DB=/home/pi/.apex/apex_local.sqlite3

# ---- connected mode (signed agent API on Vercel) ------------------------------------------------------------------
# Dashboard base URL (https only). `apex pair CODE --server URL` also stores it in $APEX_STATE_DIR/agent.json.
APEX_API_BASE_URL=
# Shared bootstrap HMAC secret: generate once with `apex keygen hmac`; the SAME value goes into the Vercel env.
AGENT_HMAC_SECRET=
# Written by `apex pair` into agent.json; set only to override.
# APEX_AGENT_ID=
# Only if Vercel Deployment Protection challenges /api/v1/agent/* (the HMAC signature is still required).
# APEX_VERCEL_BYPASS_SECRET=
# Ed25519 PUBLIC key(s) that sign model releases, from `apex keygen signing`. Held on the Pi, never taken from the
# server. Format: {"1":"<43-char base64url public key>"}. Without it no model verifies (research setups only).
# APEX_MODEL_TRUSTED_KEYS=
# 1 = run the worker without a server (offline local mode; the bot delivers from the local store).
# APEX_WORKER_OFFLINE=1
# Max symbols kept by the nightly universe refresh (default 400).
# APEX_UNIVERSE_MAX=400
# local = force the bot to use the local ledger even when paired (default: cloud ledger when paired).
# APEX_BOT_POSITIONS=local

# ---- Discord bot (see docs/DISCORD_BOT.md) ------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
APEX_OWNER_DISCORD_IDS=
# JSON {channel_key: channel_id}, or put it in $APEX_STATE_DIR/discord_channels.json
APEX_CHANNEL_MAP=
# APEX_ALLOW_LEGACY_OVERLAP=0
# APEX_DISCORD_MEMBERS_INTENT=0
# APEX_OUTBOX_POLL_SECONDS=5

# ---- market data -------------------------------------------------------------------------------------------------
# Preferred: enter Alpaca keys in the dashboard (Settings -> Integrations); the Pi receives them as an envelope
# encrypted to its X25519 key and keeps them in memory only. Manual fallback (clearly marked as such):
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# SEC_USER_AGENT="APEX research you@example.com"
