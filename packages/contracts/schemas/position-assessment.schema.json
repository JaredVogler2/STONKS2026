{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/contracts/position-assessment.schema.json",
  "title": "PositionAssessment",
  "description": "Private, per-member, deterministic assessment of a self-reported position. Research only; never a broker order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["position_id", "symbol", "asof_at", "assessment_version", "status", "risk_flags", "reasons", "price_status", "compliance_gated"],
  "properties": {
    "position_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "symbol": { "$ref": "common.schema.json#/$defs/Symbol" },
    "asof_at": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
    "assessment_version": { "type": "string", "maxLength": 32 },
    "status": { "type": "string", "enum": ["HOLD_THESIS_INTACT", "REVIEW_INVALIDATION", "CONSIDER_TRIM", "CONSIDER_EXIT", "TARGET_TOUCHED_FILL_UNKNOWN", "TIME_EXIT_REVIEW", "ADD_CRITERIA_MET", "PRICE_UNCERTAIN", "STALE_DATA", "MANUAL_WATCH", "CLOSED"] },
    "price_status": { "type": "string", "enum": ["FRESH_VERIFIED", "FRESH_UNVERIFIED", "STALE", "UNAVAILABLE"] },
    "price": { "$ref": "common.schema.json#/$defs/NonNegativeDecimalString" },
    "quote_provenance": { "$ref": "common.schema.json#/$defs/Provenance" },
    "quote_age_seconds": { "type": "integer", "minimum": 0 },
    "total_quantity": { "$ref": "common.schema.json#/$defs/NonNegativeDecimalString" },
    "avg_cost": { "$ref": "common.schema.json#/$defs/NonNegativeDecimalString" },
    "unrealized_pnl": { "$ref": "common.schema.json#/$defs/DecimalString" },
    "unrealized_pct": { "type": ["number", "null"] },
    "realized_pnl": { "$ref": "common.schema.json#/$defs/DecimalString" },
    "distance_to_stop_pct": { "type": ["number", "null"] },
    "distance_to_target_pct": { "type": ["number", "null"] },
    "marginal_reward_to_risk": { "type": ["number", "null"], "description": "Remaining upside to target vs downside to stop from the CURRENT price" },
    "sessions_held": { "type": "integer", "minimum": 0 },
    "sessions_remaining": { "type": ["integer", "null"] },
    "risk_flags": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9_]{2,48}$" }, "maxItems": 16 },
    "reasons": { "type": "array", "items": { "type": "string", "maxLength": 240 }, "maxItems": 8 },
    "original_scenario": { "type": "object" },
    "revised_scenario": { "type": "object" },
    "off_plan": { "type": "boolean" },
    "compliance_gated": { "type": "boolean", "description": "True when actionable language is suppressed by release mode" }
  }
}
