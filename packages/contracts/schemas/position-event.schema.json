{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/contracts/position-event.schema.json",
  "title": "PositionEvent",
  "description": "Immutable member position ledger event. Identity comes from the authenticated Discord interaction or owner session, never from free text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_idempotency_key", "event_type", "source"],
  "properties": {
    "client_idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{8,128}$" },
    "event_type": { "$ref": "#/$defs/PositionEventType" },
    "position_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "symbol": { "$ref": "common.schema.json#/$defs/Symbol" },
    "signal_id": { "type": "string", "pattern": "^sig_[0-9a-f]{24}$" },
    "fill": { "$ref": "position-fill.schema.json" },
    "notes": { "type": "string", "maxLength": 280 },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_event_id", "void"],
      "properties": {
        "target_event_id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "void": { "type": "boolean", "description": "true removes the target event's effect; false replaces its fill" },
        "replacement": { "$ref": "position-fill.schema.json" },
        "reason": { "type": "string", "maxLength": 200 }
      }
    },
    "source": { "type": "string", "enum": ["discord", "dashboard", "replay", "starter_import"] },
    "discord_interaction_id": { "$ref": "common.schema.json#/$defs/DiscordSnowflake" },
    "account_label": { "type": "string", "maxLength": 48 }
  },
  "$defs": {
    "PositionEventType": {
      "title": "PositionEventType",
      "type": "string",
      "enum": ["WATCH", "UNWATCH", "OPEN", "ADD", "PARTIAL_EXIT", "CLOSE", "CORRECT", "CANCEL_CORRECTION"]
    },
    "PositionState": {
      "title": "PositionState",
      "type": "string",
      "enum": ["WATCHING", "OPEN", "PARTIALLY_CLOSED", "CLOSED"]
    }
  }
}
