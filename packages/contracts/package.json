{
  "name": "@apex/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validators": "./src/validators.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/generate.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
