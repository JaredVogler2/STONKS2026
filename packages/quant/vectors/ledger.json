    {
      "name": "fifo_across_three_lots_with_sell_fees",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "10", "quantity": "1", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "ADD", "fill": { "price": "11", "quantity": "1", "fees": "0", "fill_at": "2026-10-01T14:36:00Z" } },
        { "id": "e3", "type": "ADD", "fill": { "price": "12", "quantity": "1", "fees": "0", "fill_at": "2026-10-01T14:37:00Z" } },
        { "id": "e4", "type": "PARTIAL_EXIT", "fill": { "price": "13", "quantity": "2", "fees": "0.3", "fill_at": "2026-10-02T14:35:00Z" } }
      ],
      "expect": { "state": "PARTIALLY_CLOSED", "total_quantity": "1", "avg_cost": "12", "realized_pnl": "4.7", "fees_total": "0.3", "lots_remaining": ["0", "0", "1"] }
    }
