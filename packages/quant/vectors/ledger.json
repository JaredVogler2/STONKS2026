        { "id": "e2", "type": "CORRECT", "correction": { "target": "e1", "void": false, "replacement": { "price": "189.5", "quantity": "5", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } } }
      ],
      "expect": { "state": "OPEN", "total_quantity": "5", "avg_cost": "189.5", "realized_pnl": "0", "fees_total": "0", "lots_remaining": ["5"] }
    },
