        { "id": "e2", "type": "PARTIAL_EXIT", "fill": { "price": "110", "quantity": "8", "fees": "0", "fill_at": "2026-10-03T14:35:00Z" } },
        { "id": "e3", "type": "CORRECT", "correction": { "target": "e1", "void": false, "replacement": { "price": "100", "quantity": "5", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } }, "error": "OVERSELL" }
      ],
      "expect": { "state": "PARTIALLY_CLOSED", "total_quantity": "2", "avg_cost": "100", "realized_pnl": "80", "fees_total": "0", "lots_remaining": ["2"] }
    },
    {
      "name": "watch_then_open_then_close",
      "events": [
        { "id": "e1", "type": "WATCH" },
        { "id": "e2", "type": "OPEN", "fill": { "price": "20", "quantity": "100", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e3", "type": "CLOSE", "fill": { "price": "19", "quantity": "100", "fees": "0.5", "fill_at": "2026-10-09T14:35:00Z" } }
      ],
      "checkpoints": { "e1": { "state": "WATCHING", "total_quantity": "0", "avg_cost": "0", "realized_pnl": "0" } },
      "expect": { "state": "CLOSED", "total_quantity": "0", "avg_cost": "0", "realized_pnl": "-100.5", "fees_total": "0.5", "lots_remaining": ["0"] }
    },
    {
      "name": "watch_then_unwatch",
      "events": [
        { "id": "e1", "type": "WATCH" },
        { "id": "e2", "type": "UNWATCH" }
      ],
      "expect": { "state": "CLOSED", "total_quantity": "0", "avg_cost": "0", "realized_pnl": "0", "fees_total": "0", "lots_remaining": [] }
    },
    {
      "name": "add_after_close_rejected",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "20", "quantity": "10", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "CLOSE", "fill": { "price": "21", "quantity": "10", "fees": "0", "fill_at": "2026-10-02T14:35:00Z" } },
        { "id": "e3", "type": "ADD", "fill": { "price": "20", "quantity": "5", "fees": "0", "fill_at": "2026-10-03T14:35:00Z" }, "error": "NOT_OPEN" }
      ],
      "expect": { "state": "CLOSED", "total_quantity": "0", "avg_cost": "0", "realized_pnl": "10", "fees_total": "0", "lots_remaining": ["0"] }
    },
    {
      "name": "double_open_rejected",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "20", "quantity": "10", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "OPEN", "fill": { "price": "21", "quantity": "10", "fees": "0", "fill_at": "2026-10-02T14:35:00Z" }, "error": "ALREADY_OPEN" }
      ],
      "expect": { "state": "OPEN", "total_quantity": "10", "avg_cost": "20", "realized_pnl": "0", "fees_total": "0", "lots_remaining": ["10"] }
    },
    {
      "name": "cannot_correct_a_correction",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "20", "quantity": "10", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "CORRECT", "correction": { "target": "e1", "void": false, "replacement": { "price": "21", "quantity": "10", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } } },
        { "id": "e3", "type": "CORRECT", "correction": { "target": "e2", "void": true }, "error": "BAD_TARGET" }
      ],
      "expect": { "state": "OPEN", "total_quantity": "10", "avg_cost": "21", "realized_pnl": "0", "fees_total": "0", "lots_remaining": ["10"] }
    },
    {
      "name": "void_only_entry_closes_position",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "20", "quantity": "10", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "CORRECT", "correction": { "target": "e1", "void": true } }
      ],
      "expect": { "state": "CLOSED", "total_quantity": "0", "avg_cost": "0", "realized_pnl": "0", "fees_total": "0", "lots_remaining": [] }
