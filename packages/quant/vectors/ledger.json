{
  "description": "Shared FIFO ledger vectors. Both apps/pi-worker (Python) and apps/web (TypeScript) must reproduce these exactly. Events are applied one at a time with apply(); 'error' marks the step that must be rejected (the rejected event is not kept). Money values are rounded half-even to 6 decimal places.",
  "version": "ledger-fifo-1",
  "now": "2026-10-20T20:00:00Z",
  "cases": [
    {
      "name": "single_open",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "180", "quantity": "20", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } }
      ],
      "expect": { "state": "OPEN", "total_quantity": "20", "avg_cost": "180", "realized_pnl": "0", "fees_total": "0", "lots_remaining": ["20"], "unrealized_at": { "price": "186.5", "pnl": "130" } }
    },
    {
      "name": "member_a_open_add_partial_close",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "180", "quantity": "20", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "ADD", "fill": { "price": "177", "quantity": "10", "fees": "0", "fill_at": "2026-10-02T15:00:00Z" } },
        { "id": "e3", "type": "PARTIAL_EXIT", "fill": { "price": "190", "quantity": "15", "fees": "1", "fill_at": "2026-10-06T16:00:00Z" } },
        { "id": "e4", "type": "CLOSE", "fill": { "price": "185", "quantity": "15", "fees": "0", "fill_at": "2026-10-08T19:00:00Z" } }
      ],
      "checkpoints": {
        "e2": { "state": "OPEN", "total_quantity": "30", "avg_cost": "179", "realized_pnl": "0" },
        "e3": { "state": "PARTIALLY_CLOSED", "total_quantity": "15", "avg_cost": "178", "realized_pnl": "149" }
      },
      "expect": { "state": "CLOSED", "total_quantity": "0", "avg_cost": "0", "realized_pnl": "254", "fees_total": "1", "lots_remaining": ["0", "0"] }
    },
    {
      "name": "buy_fees_in_cost_basis",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "10", "quantity": "3", "fees": "0.1", "fill_at": "2026-10-01T14:35:00Z" } }
      ],
      "expect": { "state": "OPEN", "total_quantity": "3", "avg_cost": "10.033333", "realized_pnl": "0", "fees_total": "0.1", "lots_remaining": ["3"], "unrealized_at": { "price": "10", "pnl": "-0.1" } }
    },
    {
      "name": "fractional_shares",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "181.25", "quantity": "0.5", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "ADD", "fill": { "price": "179.5", "quantity": "1.25", "fees": "0", "fill_at": "2026-10-01T15:35:00Z" } },
        { "id": "e3", "type": "PARTIAL_EXIT", "fill": { "price": "185", "quantity": "0.75", "fees": "0", "fill_at": "2026-10-03T15:35:00Z" } }
      ],
      "expect": { "state": "PARTIALLY_CLOSED", "total_quantity": "1", "avg_cost": "179.5", "realized_pnl": "3.25", "fees_total": "0", "lots_remaining": ["0", "1"] }
    },
    {
      "name": "oversell_rejected",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "50", "quantity": "10", "fees": "0", "fill_at": "2026-10-01T14:35:00Z" } },
        { "id": "e2", "type": "PARTIAL_EXIT", "fill": { "price": "55", "quantity": "11", "fees": "0", "fill_at": "2026-10-02T14:35:00Z" }, "error": "OVERSELL" }
      ],
      "expect": { "state": "OPEN", "total_quantity": "10", "avg_cost": "50", "realized_pnl": "0", "fees_total": "0", "lots_remaining": ["10"] }
    },
    {
      "name": "sell_dated_before_buy_rejected",
      "events": [
        { "id": "e1", "type": "OPEN", "fill": { "price": "50", "quantity": "10", "fees": "0", "fill_at": "2026-10-05T14:35:00Z" } },
        { "id": "e2", "type": "PARTIAL_EXIT", "fill": { "price": "55", "quantity": "5", "fees": "0", "fill_at": "2026-10-02T14:35:00Z" }, "error": "OVERSELL" }
      ],
      "expect": { "state": "OPEN", "total_quantity": "10", "avg_cost": "50", "realized_pnl": "0", "fees_total": "0", "lots_remaining": ["10"] }
    },
